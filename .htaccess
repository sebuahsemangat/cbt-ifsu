# Proteksi Akses Langsung ke File Sensitif (Database, Kredensial, Konfigurasi)
<FilesMatch "\.(sql|json|lock|log|env|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cegah Directory Browsing jika modul index tidak ditemukan
Options -Indexes
